# The Buildbot master: the flow, the web UI and REST API, the run history, and the tests'
# results to patchwork. See README.md.

[Unit]
Description=sashing: master

[Container]
ContainerName=sashing-master
Pod=sashing.pod
Image=localhost/sashing-master:latest
# An init reaping the processes the master starts.
RunInit=true
Secret=sashing-worker-pass,type=env,target=WORKERPASS
# The state: the database.
Volume=%S/sashing:/buildbot
Volume=%E/sashing-ci/project.ini:/opt/sashing/project.ini:ro
# pw-check's socket, served by whoever reports to patchwork. Without it, only the reports
# fail.
Volume=pw-check:/run/pw-check

[Service]
StateDirectory=sashing
