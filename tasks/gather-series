#!/opt/venv/bin/python
"""Gather one revision. Stdout lists patch IDs; exit 3 means prerequisites were gathered."""

import argparse
import sys
from pathlib import Path

import b4


def prerequisites(series):
    ids = list(dict.fromkeys(series.prereq_patch_ids or []))
    if not ids:
        return []
    query = ' OR '.join(f'patchid:{pid}' for pid in ids)
    matches = {}
    for message in b4.get_pi_search_results(query) or []:
        patch = b4.LoreMessage(message)
        if patch.has_diff and patch.git_patch_id in ids:
            matches[patch.git_patch_id] = patch
    for pid in ids:
        if pid not in matches:
            raise SystemExit(f'Missing prerequisite (patch-id): {pid}')
    return [matches[pid].get_am_message(add_trailers=False) for pid in ids]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('directory', type=Path)
    parser.add_argument('msgid')
    args = parser.parse_args()
    b4.setup_config(argparse.Namespace(config={'b4.linktrailermask': 'Message-ID: <%s>'}))
    msgid = args.msgid.strip('<>')
    thread = b4.get_series_by_msgid(msgid)
    if not thread or msgid not in thread.msgid_map:
        raise SystemExit(f'Message not found (Message-ID): {msgid}')
    series = thread.get_series(revision=thread.msgid_map[msgid].revision)
    if not series:
        raise SystemExit(f'Series not found (Message-ID): {msgid}')
    if not series.complete:
        missing = [f'{number}/{series.expected}'
                   for number, patch in enumerate(series.patches[1:], 1) if patch is None]
        label = 'patch' if len(missing) == 1 else 'patches'
        raise SystemExit(f'Incomplete series: missing {label} {", ".join(missing)}')
    deps = prerequisites(series)
    patches = series.get_am_ready(addlink=True)
    args.directory.mkdir(parents=True, exist_ok=True)
    for name, messages in [('series-prerequisites.mbx', deps), ('series.mbx', patches)]:
        with (args.directory / name).open('wb') as out:
            b4.save_git_am_mbox(messages, out)
    for patch in series.patches[1:]:
        print(patch.msgid)
    if deps:
        label = 'prerequisite' if len(deps) == 1 else 'prerequisites'
        print(f'Gathered with {len(deps)} {label}', file=sys.stderr)
        return 3
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
