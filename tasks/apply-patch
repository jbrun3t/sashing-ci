#!/bin/bash -e
# Usage: apply-patch DIRECTORY [NUMBER]
#
# Apply a gathered mailbox through patch NUMBER, or to the end, in the current
# checkout. Exit 1 on a conflict, 3 on success with prerequisites.

dir=${1:?usage: apply-patch DIRECTORY [NUMBER]}
target=$2
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
export GIT_COMMITTER_NAME=sashing-ci GIT_COMMITTER_EMAIL=sashing-ci@localhost

test -f "$dir/series-prerequisites.mbx" || exit 2
if [ -s "$dir/series-prerequisites.mbx" ]; then
	if ! git am "$dir/series-prerequisites.mbx"; then
		echo "${target:+Patch $target: }blocked by prerequisite"
		exit 1
	fi
fi
git mailsplit -o"$tmp" "$dir/series.mbx" >/dev/null
n=0
for mail in "$tmp"/*; do
	n=$((n + 1))
	if ! git am "$mail"; then
		if [ "$target" = "$n" ]; then
			echo "Patch $n: failed to apply"
		else
			echo "${target:+Patch $target: }blocked by patch $n"
		fi
		exit 1
	fi
	[ "$target" != "$n" ] || break
done
[ -z "$target" ] || [ "$target" = "$n" ] || { echo "Missing patch $target" >&2; exit 2; }
if [ -s "$dir/series-prerequisites.mbx" ]; then
	echo "Patch $n: applied with prerequisites"
	exit 3
fi
echo "Patch $n: applied"
