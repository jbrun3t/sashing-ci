#!/bin/bash -e
# Usage: apply-patch MBOX [NUMBER]
#
# Apply a gathered mailbox through patch NUMBER, or to the end, in the current
# checkout. Exit 1 on a conflict, 3 on success with prerequisites.

mbox=${1:?usage: apply-patch MBOX [NUMBER]}
target=$2
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
export GIT_COMMITTER_NAME=sashing-ci GIT_COMMITTER_EMAIL=sashing-ci@localhost

git mailsplit -o"$tmp" "$mbox" >/dev/null
n=0
deps=0
for mail in "$tmp"/*; do
	read -r envelope <"$mail"
	if [[ $envelope == 'From prerequisite '* ]]; then
		deps=$((deps + 1))
		label="prerequisite $deps"
		format=mboxrd
	else
		n=$((n + 1))
		label="patch $n"
		format=mbox
	fi
	if ! git am --patch-format="$format" "$mail"; then
		if [ "$target" = "$n" ]; then
			echo "Patch $n: failed to apply"
		else
			echo "${target:+Patch $target: }blocked by $label"
		fi
		exit 1
	fi
	[ "$target" != "$n" ] || break
done
[ -z "$target" ] || [ "$target" = "$n" ] || { echo "Missing patch $target" >&2; exit 2; }
if [ "$deps" -gt 0 ]; then
	echo "Patch $n: applied with prerequisites"
	exit 3
fi
echo "Patch $n: applied"
