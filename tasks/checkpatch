#!/bin/bash -e
# Usage: checkpatch
#
# Run checkpatch on the HEAD commit of the tree in the current directory, with codespell's
# dictionary for spelling. Exits 0 when clean, 3 on warnings only, 1 on errors or when
# checkpatch printed no summary.

log=$(mktemp)
trap 'rm -f "$log"' EXIT

# checkpatch exits 1 on errors and warnings alike: its summary tells them apart.
./scripts/checkpatch.pl --codespell -g HEAD 2>&1 | tee "$log"

total=$(grep -m1 '^total: ' "$log" || true)
[[ $total =~ ^total:\ ([0-9]+)\ errors,\ ([0-9]+)\ warnings ]] || exit 1
[ "${BASH_REMATCH[1]}" = 0 ] || exit 1
[ "${BASH_REMATCH[2]}" = 0 ] || exit 3
