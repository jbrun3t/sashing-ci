# The Buildbot master, Buildbot only: the flow, the checkout's master/, is mounted on
# /opt/sashing, which a reload reads again; the project, project.ini, in /etc/sashing-ci;
# the state, the database, in the working directory. Build from the repository's root:
#
#   podman build -f master/Containerfile -t localhost/sashing-master .

FROM docker.io/library/debian:trixie-slim
ARG BUILDBOT_VERSION=4.3.0

RUN apt-get update && apt-get install -y --no-install-recommends python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir \
        "buildbot==$BUILDBOT_VERSION" "buildbot-www==$BUILDBOT_VERSION"

# master.cfg imports reporterjson, next to it.
ENV PATH=/opt/venv/bin:$PATH PYTHONPATH=/opt/sashing
WORKDIR /buildbot
# upgrade-master creates the database, or brings it to this Buildbot's schema.
CMD ["sh", "-c", "cp /opt/sashing/buildbot.tac . && buildbot upgrade-master . && exec twistd --pidfile= -ny buildbot.tac"]
